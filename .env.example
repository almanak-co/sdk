# Private operator environment. Copy to `.env` and pass it explicitly:
#   almanak run ... --env-file .env
#   pytest ... --fork-env=.env
# Never commit the copy. Strategies cannot read this file.

# Alchemy key. Operator files name it with `api_key_env: ALCHEMY_API_KEY`, and
# the SDK builds each chain's RPC endpoint from it.
ALCHEMY_API_KEY=

# CoinGecko pro key. Needed only when a backtest configuration selects
# CoinGecko as a vendor source, and for `almanak ax` discovery lookups.
COINGECKO_API_KEY=

# Optional per-deployment provider limits, read from the gateway's environment.
# ALMANAK_GATEWAY_RPC_REQUESTS_PER_SECOND=
# ALMANAK_GATEWAY_COINGECKO_REQUESTS_PER_MINUTE=
# ALMANAK_GATEWAY_MORPHO_REQUESTS_PER_MINUTE=
# ALMANAK_GATEWAY_HYPERLIQUID_WEIGHT_PER_MINUTE=

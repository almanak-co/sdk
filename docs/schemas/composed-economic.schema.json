                },
                "risk_prices": {
                  "$ref": "aave-backtest.schema.json#/oneOf/1/properties/data/properties/risk_prices"
                },
                "prices": {
                  "$ref": "aave-backtest.schema.json#/oneOf/1/properties/data/properties/prices"
                },
                "vendors": {
                  "$ref": "aave-backtest.schema.json#/oneOf/1/properties/data/properties/vendors"
                },
                "sampling_overrides": {
                  "$ref": "aave-backtest.schema.json#/oneOf/1/properties/data/properties/sampling_overrides"
                }
              },
              "required": [
                "source",
                "rate_sample_seconds",

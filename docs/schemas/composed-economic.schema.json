    },
    "costs": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "aave_v3": {
          "$ref": "aave-v3-economic.schema.json#/properties/costs"
        },
        "uniswap_v3": {
          "$ref": "uniswap-v3-economic.schema.json#/properties/costs"

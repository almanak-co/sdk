                },
                "max_bitmap_words": {
                  "$ref": "aerodrome-slipstream-economic.schema.json#/properties/data/properties/max_bitmap_words"
                },
                "max_initialized_ticks": {
                  "$ref": "aerodrome-slipstream-economic.schema.json#/properties/data/properties/max_initialized_ticks"
                },
                "coverage": {
                  "$ref": "aerodrome-slipstream-economic.schema.json#/properties/data/properties/coverage"
                },
                "source": {
                  "$ref": "aerodrome-slipstream-economic.schema.json#/properties/data/properties/source"
                },
                "max_liquidity_events": {
                  "$ref": "aerodrome-slipstream-economic.schema.json#/properties/data/properties/max_liquidity_events"
                },
                "max_liquidity_log_requests": {
                  "$ref": "aerodrome-slipstream-economic.schema.json#/properties/data/properties/max_liquidity_log_requests"
                }
              },
              "required": [
                "sample_seconds",
                "max_age_seconds",
                "max_samples",
                "max_bitmap_words",
                "max_initialized_ticks",
                "coverage",
                "source",
                "max_liquidity_events",
                "max_liquidity_log_requests"
              ],
              "type": "object"
            },
            "aave_v4": {
              "additionalProperties": false,
              "properties": {
                "source": {
                  "$ref": "aave-backtest.schema.json#/oneOf/1/properties/data/properties/source"
                },

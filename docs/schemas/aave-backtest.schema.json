        },
        "vendors": {
          "default": [],
          "items": {
            "$ref": "#/$defs/VendorBinding"
          },
          "title": "Vendors",
          "type": "array"
        },
        "sampling_overrides": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SamplingOverride"
          },
          "title": "Sampling Overrides",
          "type": "array"
        }
      },
      "required": [
        "source",
        "rate_sample_seconds",
        "risk_prices"
      ],
      "title": "EconomicDataPolicy",
      "type": "object"

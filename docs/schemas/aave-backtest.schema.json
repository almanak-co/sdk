    "EconomicFixedCosts": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "fixed_native",
          "title": "Kind",
          "type": "string"
        },
        "supply": {
          "minimum": 0,
          "title": "Supply",
          "type": "integer"
        },
        "withdraw": {
          "minimum": 0,
          "title": "Withdraw",
          "type": "integer"
        },
        "borrow": {
          "minimum": 0,
          "title": "Borrow",
          "type": "integer"
        },
        "repay": {
          "minimum": 0,
          "title": "Repay",
          "type": "integer"
        },
        "collateral": {
          "minimum": 0,
          "title": "Collateral",
          "type": "integer"
        },
        "refresh": {
          "minimum": 0,
          "title": "Refresh",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "supply",
        "withdraw",
        "borrow",
        "repay",
        "collateral",
        "refresh"
      ],
      "title": "EconomicFixedCosts",
      "type": "object"
    },
    "ExcludedCosts": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "excluded",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "ExcludedCosts",
      "type": "object"
    },
    "FixedCosts": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "fixed_native",
          "title": "Kind",
          "type": "string"
        },
        "approve": {
          "minimum": 0,
          "title": "Approve",
          "type": "integer"
        },
        "supply": {
          "minimum": 0,
          "title": "Supply",
          "type": "integer"
        },
        "withdraw": {
          "minimum": 0,
          "title": "Withdraw",
          "type": "integer"
        },
        "revoke": {
          "minimum": 0,
          "title": "Revoke",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "approve",
        "supply",
        "withdraw",
        "revoke"

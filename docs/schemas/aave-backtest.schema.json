          "minItems": 1,
          "title": "Funds",
          "type": "array"
        },
        "market_model": {
          "const": "economic",
          "title": "Market Model",
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/EconomicDataPolicy"
        },
        "costs": {
          "discriminator": {
            "mapping": {
              "excluded": "#/$defs/ExcludedCosts",
              "fixed_native": "#/$defs/EconomicFixedCosts"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/ExcludedCosts"
            },
            {
              "$ref": "#/$defs/EconomicFixedCosts"
            }
          ],
          "title": "Costs"
        }
      },
      "required": [
        "schedule",
        "history",
        "funds",
        "market_model",
        "data",
        "costs"
      ],
      "title": "EconomicBacktestConfig",
      "type": "object"
    },
    "EconomicDataPolicy": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "const": "aave_v4_archive",
          "title": "Source",
          "type": "string"
        },
        "rate_sample_seconds": {
          "exclusiveMinimum": 0,
          "title": "Rate Sample Seconds",
          "type": "integer"
        },
        "risk_prices": {
          "enum": [
            "spoke_oracle_events",
            "configured"
          ],
          "title": "Risk Prices",
          "type": "string"
        },
        "prices": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PriceBinding"
          },
          "title": "Prices",

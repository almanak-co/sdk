{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Aave V4 reserve selection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "connector",
    "chain",
    "spoke",
    "reserve_id"
  ],
  "properties": {
    "connector": {
      "const": "aave_v4"
    },
    "chain": {
      "type": "string",
      "pattern": "^[-a-z0-9]{3,8}:[-_a-zA-Z0-9]{1,32}$"
    },
    "spoke": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "reserve_id": {
      "type": "integer",
      "minimum": 0
    },
    "assertions": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "asset": {
              "type": "string",
              "pattern": "^[-a-z0-9]{3,8}:[-_a-zA-Z0-9]{1,32}/[-a-z0-9]{3,8}:[-.%a-zA-Z0-9]{1,128}$"
            },
            "hub": {
              "type": "string",
              "pattern": "^0x[0-9a-fA-F]{40}$"
            },
            "decimals": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  }
}

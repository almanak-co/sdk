{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Compound V3 market selection",
  "description": "One Comet and one asset it lists. The base asset keeps the Comet's base price feed; every other asset must appear in the Comet's own collateral list.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "connector",
    "chain",
    "comet",
    "asset"
  ],
  "properties": {
    "connector": {
      "const": "compound_v3"
    },
    "chain": {
      "type": "string",
      "pattern": "^[-a-z0-9]{3,8}:[-_a-zA-Z0-9]{1,32}$"
    },
    "comet": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "asset": {
      "type": "string",
      "pattern": "^[-a-z0-9]{3,8}:[-_a-zA-Z0-9]{1,32}/[-a-z0-9]{3,8}:[-.%a-zA-Z0-9]{1,128}$"
    },
    "assertions": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "base_asset": {
              "type": "string",
              "pattern": "^[-a-z0-9]{3,8}:[-_a-zA-Z0-9]{1,32}/[-a-z0-9]{3,8}:[-.%a-zA-Z0-9]{1,128}$"
            },
            "price_feed": {
              "type": "string",
              "pattern": "^0x[0-9a-fA-F]{40}$"
            },
            "decimals": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  }
}

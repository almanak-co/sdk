{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Aerodrome pool selection",
  "description": "The author names the pool; its stable or volatile invariant is read from the chain.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "connector",
    "chain",
    "pool"
  ],
  "properties": {
    "connector": {
      "const": "aerodrome"
    },
    "chain": {
      "type": "string",
      "pattern": "^[-a-z0-9]{3,8}:[-_a-zA-Z0-9]{1,32}$"
    },
    "pool": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "assertions": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "currency0": {
              "type": "string",
              "pattern": "^[-a-z0-9]{3,8}:[-_a-zA-Z0-9]{1,32}/[-a-z0-9]{3,8}:[-.%a-zA-Z0-9]{1,128}$"
            },
            "currency1": {
              "type": "string",
              "pattern": "^[-a-z0-9]{3,8}:[-_a-zA-Z0-9]{1,32}/[-a-z0-9]{3,8}:[-.%a-zA-Z0-9]{1,128}$"
            },
            "stable": {
              "type": "boolean"
            },
            "decimals0": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            "decimals1": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SparkLend reserve selection",
  "description": "One reserve of this chain's reviewed Pool. An explicit pool must equal the reviewed entry; omit it unless a chain ships several reviewed Pools.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "connector",
    "chain",
    "asset"
  ],
  "properties": {
    "connector": {
      "const": "sparklend"
    },
    "chain": {
      "type": "string",
      "pattern": "^[-a-z0-9]{3,8}:[-_a-zA-Z0-9]{1,32}$"
    },
    "asset": {
      "type": "string",
      "pattern": "^[-a-z0-9]{3,8}:[-_a-zA-Z0-9]{1,32}/[-a-z0-9]{3,8}:[-.%a-zA-Z0-9]{1,128}$"
    },
    "pool": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{40}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "assertions": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "a_token": {
              "type": "string",
              "pattern": "^[-a-z0-9]{3,8}:[-_a-zA-Z0-9]{1,32}/[-a-z0-9]{3,8}:[-.%a-zA-Z0-9]{1,128}$"
            },
            "variable_debt_token": {
              "type": "string",
              "pattern": "^[-a-z0-9]{3,8}:[-_a-zA-Z0-9]{1,32}/[-a-z0-9]{3,8}:[-.%a-zA-Z0-9]{1,128}$"
            },
            "decimals": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  }
}

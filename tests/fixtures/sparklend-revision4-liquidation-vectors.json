  "wrapper": "// SPDX-License-Identifier: MIT\npragma solidity ^0.8.10;\nimport {LiquidationLogic} from \"lib/sparklend-v1-core/contracts/protocol/libraries/logic/LiquidationLogic.sol\";\nimport {DataTypes} from \"lib/sparklend-v1-core/contracts/protocol/libraries/types/DataTypes.sol\";\nimport {IPriceOracleGetter} from \"lib/sparklend-v1-core/contracts/interfaces/IPriceOracleGetter.sol\";\ncontract LiquidationProbe {\nDataTypes.ReserveData internal collateral;\nmapping(address=>uint256) internal prices;\nuint256 internal borrowed;\nfunction balanceOf(address) external view returns (uint256) { return borrowed; }\nfunction close(uint256 amount,uint256 health,uint256 requested) external returns (uint256,uint256,uint256) {\nborrowed=amount;\nDataTypes.ReserveCache memory debt;\ndebt.variableDebtTokenAddress=address(this); debt.stableDebtTokenAddress=address(0x3000);\nDataTypes.ExecuteLiquidationCallParams memory params; params.user=address(1); params.debtToCover=requested;\nreturn LiquidationLogic._calculateDebt(debt,params,health);\n}\nfunction getAssetPrice(address asset) external view returns (uint256) { return prices[asset]; }\nfunction quote(uint256[8] calldata args) external returns (uint256,uint256,uint256) {\nprices[address(1)] = args[0]; prices[address(2)] = args[1];\ncollateral.configuration.data = (args[6]<<48) | (args[5]<<152);\nDataTypes.ReserveCache memory debt;\ndebt.reserveConfiguration.data = args[7]<<48;\nreturn LiquidationLogic._calculateAvailableCollateralToLiquidate(collateral,debt,address(1),address(2),args[3],args[2],args[4],IPriceOracleGetter(address(this)));\n}\n}\ncontract ZeroDebtToken { function balanceOf(address) external pure returns (uint256) { return 0; } }\n",

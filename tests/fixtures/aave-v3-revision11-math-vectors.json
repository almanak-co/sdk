  "wrapper": "// SPDX-License-Identifier: MIT\npragma solidity ^0.8.27;\nimport {TokenMath} from \"src/contracts/protocol/libraries/helpers/TokenMath.sol\";\nimport {MathUtils} from \"src/contracts/protocol/libraries/math/MathUtils.sol\";\ncontract MathProbe {\nfunction rounding(uint256 value, uint256 index) external pure returns (uint256[6] memory) {\nreturn [TokenMath.getATokenMintScaledAmount(value,index),TokenMath.getATokenBurnScaledAmount(value,index),TokenMath.getATokenBalance(value,index),TokenMath.getVTokenMintScaledAmount(value,index),TokenMath.getVTokenBurnScaledAmount(value,index),TokenMath.getVTokenBalance(value,index)];\n}\nfunction interest(uint256 rate, uint40 elapsed) external view returns (uint256,uint256) {\nreturn (MathUtils.calculateLinearInterest(rate,uint40(block.timestamp)-elapsed),MathUtils.calculateCompoundedInterest(rate,0,elapsed));\n}\n}\n",

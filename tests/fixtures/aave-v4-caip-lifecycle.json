  "strategy": {
    "filename": "strategy.py",
    "source": "\"\"\"Supply each named WETH allocation once; hold until requested teardown.\"\"\"\n\nfrom almanak_v3.lending import DecisionInput, Operation\n\n\ndef decide(context: DecisionInput) -> Operation | None:\n    observations = {item.account: item for item in context.observations}\n    owned = {item.account: item.shares for item in context.owned}\n    for allocation in context.config.allocations:\n        name = allocation.account\n        observed = observations[name]\n        if context.teardown:\n            if owned[name]:\n                return Operation(account=name, kind=\"withdraw\")\n            if observed.allowance:\n                return Operation(account=name, kind=\"revoke\")\n        elif name not in context.entered:\n            if observed.allowance != allocation.amount:\n                return Operation(account=name, kind=\"approve\")\n            return Operation(account=name, kind=\"supply\")\n    return None\n"
  },

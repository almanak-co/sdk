  "wrapper": "// SPDX-License-Identifier: MIT\npragma solidity ^0.8.0;\nimport {WadRayMath} from \"lib/sparklend-v1-core/contracts/protocol/libraries/math/WadRayMath.sol\";\nimport {MathUtils} from \"lib/sparklend-v1-core/contracts/protocol/libraries/math/MathUtils.sol\";\ncontract MathProbe {\nfunction rounding(uint256 value, uint256 index) external pure returns (uint256[6] memory) {\nreturn [WadRayMath.rayDiv(value,index),WadRayMath.rayDiv(value,index),WadRayMath.rayMul(value,index),WadRayMath.rayDiv(value,index),WadRayMath.rayDiv(value,index),WadRayMath.rayMul(value,index)];\n}\nfunction interest(uint256 rate, uint40 elapsed) external view returns (uint256,uint256) {\nreturn (MathUtils.calculateLinearInterest(rate,uint40(block.timestamp)-elapsed),MathUtils.calculateCompoundedInterest(rate,0,elapsed));\n}\n}\n",

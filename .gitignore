.DS_Store
.venv/
__pycache__/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
dist/
/artifacts/
test-results*.xml
pytest-*.log
/.local/
*.egg-info/
.env
.env.*
!.env.example

# Generated run evidence is retained locally, outside Git.
/docs/internal/reports/evidence/
# Derived obligation ledgers are regenerated from local evidence, not committed.
/docs/internal/reports/*-obligation-ledger.json

# Docs site build output and generated pages
/site/
/site-llms/
/.vercel/
/docs/cli/
/docs/support.md

# Almanak Code binaries, downloaded at build time by scripts/update_binaries.sh
src/almanak/bin/almanak-code-*
.bin_stash/

# LLM docs bundle, generated at publish time by make docs-llms
src/almanak/llms/llms-full.txt

# Google Actions authentication artifacts must never enter source distributions.
gha-creds-*.json

# Local cache of pinned retained-evidence copies (scripts/evidence_fixtures.py); the
# copies themselves are committed under tests/fixtures/evidence/.
/.fixture-cache/

# Hypothesis caches constants it reads from source here; tests keep no example database.
.hypothesis/
